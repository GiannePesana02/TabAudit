{
  "manifest_version": 3,
  "name": "TabAudit",
  "version": "2.0.0",
  "description": "AI-powered tab manager. Works silently, suggests smartly, never interrupts.",
  "permissions": ["tabs", "storage", "alarms", "tabGroups"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
